# Default search parameters (can be overridden via CLI flags)
DEFAULT_SITES=indeed,linkedin,zip_recruiter,glassdoor
DEFAULT_RESULTS_WANTED=20
DEFAULT_COUNTRY=USA

# Output directory for scraped results
OUTPUT_DIR=./data

# Directory for generated cover letter drafts
DRAFTS_DIR=./data/drafts

# Path to your resume/background, used as context for cover letter drafts
PROFILE_PATH=./profile/resume.md

# Required for --generate-drafts (cover letter generation)
ANTHROPIC_API_KEY=

# Optional default filters (can be overridden via CLI flags)
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=
MIN_SALARY=
